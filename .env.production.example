APP_NAME=SIGAL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sigal
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO

SIGAL_DEPLOYMENT_TIER=production
SIGAL_ENVIRONMENT_LABEL="PRODUCCIÓN"
SIGAL_OPERATIONAL_RESET_ENABLED=false
SIGAL_BIND_IP=
SIGAL_HTTP_PORT=80
SIGAL_HTTPS_PORT=443

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=sigal
DB_USERNAME=sigal
DB_PASSWORD=
POSTGRES_DB=sigal
POSTGRES_USER=sigal
POSTGRES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=sigal
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@sigal.local"
MAIL_FROM_NAME="SIGAL"

VITE_APP_NAME=SIGAL
